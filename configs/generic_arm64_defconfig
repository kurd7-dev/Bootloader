CONFIG_ARM=y
CONFIG_ARM64=y
CONFIG_ARCH_UNSPECIFIED=y
CONFIG_SYS_TEXT_BASE=0x80000000

# Boot configuration
CONFIG_SPL=y
CONFIG_SPL_SERIAL=y
CONFIG_SPL_SYS_MALLOC_F_LEN=0x4000
CONFIG_SYS_SPL_MALLOC_SIZE=0x4000

# Storage
CONFIG_MMC=y
CONFIG_MMC_WRITE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ARASAN=y
CONFIG_SPL_MMC=y
CONFIG_SPL_FAT=y
CONFIG_SPL_FAT_WRITE=y

# Filesystems
CONFIG_FAT_WRITE=y
CONFIG_FS_FAT=y

# Shell and commands
CONFIG_CMDLINE=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_LOAD=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_FAT=y

# Device tree
CONFIG_OF_LIBFDT=y
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y

# Serial
CONFIG_PL011_SERIAL=y
CONFIG_SYS_NS16550=y

# Android
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_CMD_ABOOTIMG=y

# Debug
CONFIG_DEBUG_UART=y